#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="${SEARCH_JAR:-$(ls -S "$DIR"/target/*.jar 2>/dev/null | head -n1 || true)}"

if [[ -z "$JAR" || ! -f "$JAR" ]]; then
  echo "Jar not found. Build the project first: mvn package" >&2
  exit 1
fi

exec java -cp "$JAR" client.SearchCli "$@"
